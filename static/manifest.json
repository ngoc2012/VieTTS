{
  "manifest_version": 3,
  "name": "VieNeu-TTS",
  "version": "1.0",
  "description": "Vietnamese Text-to-Speech with instant voice cloning",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://*/*",
    "https://*/*"
  ]
}
